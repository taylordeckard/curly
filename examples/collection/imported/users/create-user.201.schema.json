{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/User",
  "$defs": {
    "User": {
      "type": "object",
      "required": [
        "name",
        "email"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "readOnly": true,
          "minimum": 1
        },
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        }
      }
    }
  }
}
