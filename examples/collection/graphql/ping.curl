# @name GraphQL ping
# @description Minimal request; `curly gql introspect graphql/ping.curl` caches the schema.
# @tags graphql
--variable GQL_QUERY@graphql/ping.graphql
--variable GQL_VARS@graphql/ping.vars.json
--expand-url {{BASE_URL}}/graphql
--header "Content-Type: application/json"
--header "Accept: application/json"
--expand-data "{\"query\":\"{{GQL_QUERY:json}}\",\"variables\":{{GQL_VARS}}}"
